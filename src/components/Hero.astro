---
interface QuoteItem { text: string; author: string; }
interface Props {
  greeting: string;
  name: string;
  summary: string;
  quotes: QuoteItem[];
  photoSrc?: string;
  initials?: string;
  ctaText: string;
  ctaHref: string;
}
const { greeting, name, summary, quotes, photoSrc = "/images/gallery/profile.png", ctaText, ctaHref } = Astro.props;
---
<section class="hero">
  <div class="hero-text">
    <p class="greeting">{greeting}</p>
    <h1 class="name">{name}</h1>
  </div>
  <img class="profile-photo" src={photoSrc}/>
</section>

<section class="quotes-cycler" aria-live="polite">
  {quotes.map((q, i) => (
    <blockquote class="quote-item" class:list={[{ active: i === 0 }]}>
      <p>"{q.text}"</p>
      <footer>— {q.author}</footer>
    </blockquote>
  ))}
</section>

<section class="summary">
  <p set:html={summary}>{summary}</p>
  <a href={ctaHref} class="cta-button">{ctaText}</a>
</section>

<style>
.hero { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-lg); padding: var(--space-lg) 0; }
.hero-text { flex: 1; min-width: 250px; }
.greeting { font-size: var(--text-lg); color: var(--color-muted); margin: 0; }
.name { font-size: var(--text-3xl); margin: 0; line-height: 1.1; color: var(--color-primary); }
.profile-photo { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.profile-photo.placeholder { display: flex; align-items: center; justify-content: center; background: var(--color-primary); color: white; font-size: var(--text-2xl); font-weight: bold; }
.summary { max-width: 700px; margin: 0 auto var(--space-md) auto; padding: var(--space-md); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; text-align: center; font-size: var(--text-lg); }
.cta-button { display: inline-block; margin-top: var(--space-sm); padding: 0.6rem 1.4rem; background: var(--color-tertiary); color: var(--color-text); text-decoration: none; border-radius: 6px; font-weight: bold; transition: background 0.2s ease; }
.cta-button:hover { background: var(--color-primary); color: white; }
.quotes-cycler { position: relative; max-width: 700px; min-height: 100px; margin: 0 auto var(--space-xl) auto; }
.quote-item { position: absolute; inset: 0; margin: 0; padding: var(--space-sm) var(--space-md); border-left: 4px solid var(--color-secondary); font-style: italic; font-size: var(--text-sm); opacity: 0; transform: translateY(8px); transition: opacity 0.8s ease, transform 0.8s ease; pointer-events: none; }
.quote-item.active { opacity: 1; transform: translateY(0); pointer-events: auto; }
.quote-item footer { margin-top: var(--space-xs); font-style: normal; font-weight: bold; text-align: right; color: var(--color-muted); }
</style>

<script>
  // Cycles through however many .quote-item elements exist — add more quotes
  // to the `quotes` prop and this keeps working with no changes here.
  const container = document.querySelector('.quotes-cycler');
  if (container) {
    const items = container.querySelectorAll('.quote-item');
    let current = 0;
    const intervalMs = 8000; // time each quote stays visible

    if (items.length > 1) {
      setInterval(() => {
        items[current].classList.remove('active');
        current = (current + 1) % items.length;
        items[current].classList.add('active');
      }, intervalMs);
    }
  }
</script>