---
interface QuoteItem {
  text: string;
  author: string;
}
interface Props {
  greeting: string;
  name: string;
  summary: string[];
  quotes: QuoteItem[];
  photoSrc: string;
  ctaText: string;
  ctaHref: string;
}
const { greeting, name, summary, quotes, photoSrc, ctaText, ctaHref } =
  Astro.props;
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-text">
      <p class="greeting">{greeting}</p>
      <h1 class="name">{name}</h1>
    </div>

    <div class="quotes-cycler" aria-live="polite">
      {
        quotes.map((q, i) => (
          <blockquote class="quote-item" class:list={[{ active: i === 0 }]}>
            <p>"{q.text}"</p>
            <footer>— {q.author}</footer>
          </blockquote>
        ))
      }
    </div>
  </div>

  <img class="profile-photo" src={photoSrc} />
</section>

<section class="summary">
  <!-- <p class="summary-text" set:html={summary} /> -->
   {
    summary.map(
      (item) => (<p class="summary-text">{item}</p>)
    )
   }
  <a class="cta-button" href={ctaHref}>{ctaText}</a>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
  }
  .hero-left {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .greeting {
    font-size: 1.8rem;
    color: var(--color-muted);
    margin: 0;
  }
  .name {
    font-size: 3.6rem;
    margin: 0;
    line-height: 1.1;
    color: var(--color-primary);
  }

  .profile-photo {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .profile-photo.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    font-size: var(--text-2xl);
    font-weight: bold;
  }

  .summary {
    margin: 0 auto var(--space-md) auto;
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-align: center;
    font-size: var(--text-lg);
  }
  .summary-text {
    text-align: left;
  }
  .cta-button {
    display: inline-block;
    margin-top: var(--space-sm);
    padding: 0.6rem 1.4rem;
    background: var(--color-tertiary);
    color: var(--color-text);
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    transition: background 0.2s ease;
  }
  .cta-button:hover {
    background: var(--color-primary);
    color: white;
  }

  .quotes-cycler {
    position: relative;
    width: 100%;
    min-height: 90px;
  }
  .quote-item {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    font-style: italic;
    font-size: var(--text-sm);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
    pointer-events: none;
  }
  .quote-item.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .quote-item footer {
    margin-top: var(--space-xs);
    font-style: normal;
    font-weight: bold;
    text-align: right;
    color: var(--color-muted);
  }
</style>

<script>
  const container = document.querySelector(".quotes-cycler");
  if (container) {
    const items = container.querySelectorAll(".quote-item");
    let current = 0;
    const intervalMs = 12000;

    if (items.length > 1) {
      setInterval(() => {
        items[current].classList.remove("active");
        current = (current + 1) % items.length;
        items[current].classList.add("active");
      }, intervalMs);
    }
  }
</script>
