---
interface QuoteItem {
  text: string;
  author: string;
  book: string
}
interface Props {
  greeting: string;
  name: string;
  summary: string[];
  quotes: QuoteItem[];
  photoSrc: string;
  ctaText: string;
  ctaHref: string;
}
const { greeting, name, summary, quotes, photoSrc, ctaText, ctaHref } =
  Astro.props;
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-text">
      <p class="greeting">{greeting}</p>
      <h1 class="name">{name}</h1>
    </div>

    <div class="quotes-cycler" aria-live="polite">
      {
        quotes.map((q, i) => (
          <blockquote class="quote-item" class:list={[{ active: i === 0 }]}>
            <p>"{q.text}"</p>
            <footer>— <cite>{q.author}<em>{q.book}</em></cite></footer>
          </blockquote>
        ))
      }
    </div>
  </div>

  <img class="profile-photo" src={photoSrc} />
</section>

<section class="summary">
  <!-- <p class="summary-text" set:html={summary} /> -->
   {
    summary.map(
      (item) => (<p class="summary-text">{item}</p>)
    )
   }
  <a class="cta-button" href={ctaHref}>{ctaText}</a>
</section>

<script>
  const container = document.querySelector(".quotes-cycler");
  if (container) {
    const items = container.querySelectorAll(".quote-item");
    let current = 0;
    const intervalMs = 12000;

    if (items.length > 1) {
      setInterval(() => {
        items[current].classList.remove("active");
        current = (current + 1) % items.length;
        items[current].classList.add("active");
      }, intervalMs);
    }
  }
</script>
