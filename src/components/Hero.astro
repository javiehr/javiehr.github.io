---
interface QuoteItem { text: string; author: string; }
interface Props {
  greeting: string;
  name: string;
  summary: string;
  quotes: QuoteItem[];
  photoSrc?: string;
  photoAlt: string;
  initials?: string;
}
const { greeting, name, summary, quotes, photoSrc, photoAlt, initials = "" } = Astro.props;
---
<section class="hero">
  <div class="hero-text">
    <p class="greeting">{greeting}</p>
    <h1 class="name">{name}</h1>
  </div>
  {photoSrc ? (
    <img class="profile-photo" src={photoSrc} alt={photoAlt} />
  ) : (
    <div class="profile-photo placeholder" aria-label={photoAlt}>{initials}</div>
  )}
</section>

<section class="quotes-cycler" aria-live="polite">
  {quotes.map((q, i) => (
    <blockquote class="quote-item" class:list={[{ active: i === 0 }]}>
      <p>"{q.text}"</p>
      <footer>— {q.author}</footer>
    </blockquote>
  ))}
</section>

<section class="summary">
  <p>{summary}</p>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 3rem 1rem;
  }
  .hero-text { flex: 1; min-width: 250px; }
  .greeting { font-size: 1.5rem; color: #888; margin: 0; }
  .name { font-size: 3.5rem; margin: 0; line-height: 1.1; }
  .profile-photo {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .profile-photo.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #6b93c7;
    color: white;
    font-size: 3rem;
    font-weight: bold;
  }
  .summary {
    max-width: 800px;
    margin: 0 auto 2rem auto;
    padding: 1.5rem;
    background: #f0f4f8;
    border-radius: 8px;
    text-align: center;
  }

  .quotes-cycler {
    position: relative;
    max-width: 800px;
    min-height: 100px; /* reserve space so layout doesn't jump between quotes */
    margin: 0 auto 3rem auto;
  }
  .quote-item {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid #6b93c7;
    font-style: italic;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    pointer-events: none;
  }
  .quote-item.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .quote-item footer {
    margin-top: 0.5rem;
    font-style: normal;
    font-weight: bold;
    text-align: right;
  }
</style>

<script>
  // Cycles through however many .quote-item elements exist — add more quotes
  // to the `quotes` prop and this keeps working with no changes here.
  const container = document.querySelector('.quotes-cycler');
  if (container) {
    const items = container.querySelectorAll('.quote-item');
    let current = 0;
    const intervalMs = 8000; // time each quote stays visible

    if (items.length > 1) {
      setInterval(() => {
        items[current].classList.remove('active');
        current = (current + 1) % items.length;
        items[current].classList.add('active');
      }, intervalMs);
    }
  }
</script>