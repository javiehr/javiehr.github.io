---
import BaseLayout from "../layouts/BaseLayout.astro";

const experience = [
  {
    date: "2024 — 2026",
    company:
      "Central Petroleum Drilling and Extraction Company (EPEPC) — Matanzas, Cuba",
    responsibilities: [
      "Maintained and repaired variable frequency drives (VFDs) for industrial equipment",
      "Serviced inverters/chargers and switch-mode power supplies (SMPS)",
      "Diagnosed and resolved electrical faults on industrial power-electronic systems",
    ],
  },
];

const education = [
  {
    date: "2018 — 2023",
    degree: "Automation Engineering",
    institution:
      "Technological University of Havana José Antonio Echeverría (CUJAE) — Havana, Cuba",
  },
];

const technicalSkills = [
  {
    area: "Hardware and Embedded Systems",
    skills: [
      "Microcontrollers",
      "Microchip PIC Family",
      "Field-Programmable Gate Array (FPGA)",
      "Analog & Digital Circuit Simulation",
    ],
  },
];
---

<BaseLayout title="About Me">
  <h1>Portfolio</h1>

  <section>
    <h2>Background</h2>
    <p>
      My passion for technology and engineering naturally led me to pursue a
      degree in Automation Engineering at the Universidad Tecnológica de La
      Habana (CUJAE) from 2018 to 2023. Throughout my studies, I focused heavily
      on electric circuits, electronics, and programming. Driven by a spirit of
      collaboration, I regularly organized study groups with peers to share
      knowledge and break down complex concepts together. <br /> In 2023, I began
      my professional career at a personal hygiene manufacturing plant as an IT specialist,
      while also assisting with the maintenance and repair of automated production
      machinery. <br /> In 2024, I joined the Empresa de Perforación y Extracción
      de Petróleo del Centro (CUPET)—the country's leading crude oil production division—as
      an Automation Specialist. In this role, I expanded my hands-on expertise in
      industrial instrumentation, power electronics, and embedded control programming.
      Facing resource constraints, I successfully repaired critical electronic control
      devices to restore halted production lines. My responsibilities also included
      installing and maintaining electrical panels and instrumentation across extraction
      workflows, as well as diagnosing and repairing medium-voltage variable frequency
      drives (VFDs) at well sites. <br /> Currently, I am expanding my career focus
      toward embedded systems design, digital electronics, and software development,
      with a strong interest in integrating AI technologies directly onto embedded
      hardware.
    </p>
  </section>

  <section>
    <h2>Education</h2>
    {
      education.map((edu) => (
        <article class="entry-card">
          <div class="entry-header">
            <span class="entry-date">{edu.date}</span>
            <span class="entry-title">{edu.institution}</span>
          </div>
          <p class="entry-degree">{edu.degree}</p>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Experience</h2>
    {
      experience.map((job) => (
        <article class="entry-card">
          <div class="entry-header">
            <span class="entry-date">{job.date}</span>
            <span class="entry-title">{job.company}</span>
          </div>
          <ul class="entry-list">
            {job.responsibilities.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Technical Skills</h2>
    {
      technicalSkills.map((skillArea) => (
        <article class="skill-card">
          <h3 class="skill-area">{skillArea.area}</h3>
          <ul class="skill-list">
            {skillArea.skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Beyond Work</h2>
    <p><!-- hobbies, interests, whatever makes it feel like you --></p>
  </section>
</BaseLayout>

<style>
  .entry-card {
    border-left: 3px solid var(--color-secondary);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-md);
    background: var(--color-surface);
    border-radius: 0 8px 8px 0;
  }
  .entry-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--space-sm);
    margin-bottom: var(--space-xs);
  }
  .entry-date {
    font-weight: bold;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .entry-title {
    font-weight: bold;
    color: var(--color-primary);
  }
  .entry-degree {
    margin: 0;
    color: var(--color-text);
  }
  .entry-list {
    margin: 0;
    padding-left: 1.25rem;
  }
  .entry-list li {
    margin-bottom: 0.35rem;
  }
  .skill-card {
    margin-bottom: var(--space-md);
  }
  .skill-area {
    font-size: var(--text-lg);
    margin-bottom: var(--space-xs);
    color: var(--color-primary);
  }
  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-list li {
    background: var(--color-secondary-light);
    color: var(--color-primary);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: var(--text-sm);
  }
</style>
