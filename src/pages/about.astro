---
import { boolean, string } from "astro:schema";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/about.css"

const experience = [
  {
    date: "2024 — 2026",
    company: {
      name: "Central Petroleum Drilling and Extraction Company (EPEPC)",
      social_media: [
        {icon:"/x.svg", link:"https://x.com/EPEPCentro?s=20"},
        {icon:"/facebook.svg", link:"https://www.facebook.com/epepc"}
      ],
    },
    responsibilities: [
      "Maintained, repaired, and installed Variable Frequency Drives (VFDs) and power electronics units, restoring operational capacity for crude oil extraction.",
      "Executed preventive and corrective maintenance on industrial automation equipment, workstation PCs, and control loop tuning on field instrumentation (HART and FOUNDATION Fieldbus protocols).",
      "Executed component-level repair and hardware troubleshooting on Programmable Logic Controllers (Siemens S7-200, Smar DF63) restoring critical control and communication infrastructure.",
      "Installed and maintained electrical panels, instrumentation, and control systems",
    ],
  },
  {
    date: "2023 — 2024",
    company: {
      name: "Suchel Jovel Subsidiary - Household & Personal Care Manufacturing",
      social_media: []
    },
    responsibilities: [
      "Provided IT support for the plant's computer systems and networks",
      "Assisted in the maintenance and repair of automated production machinery",
    ],
  },
];

const education = [
  {
    date: "2018 — 2023",
    degree: "B.Eng. Automation Engineering",
    institution: {
      name: "Technological University of Havana José Antonio Echeverría (CUJAE)",
      social_media: [
        {icon: "/website.svg", link: "https://www.cujae.edu.cu/"},
        {icon:"/x.svg", link:"https://x.com/CujaeRedSocial?s=20"},
        {icon:"/facebook.svg", link:"https://www.facebook.com/CujaeRedSocial"}
      ],
    }
  },
];

const technicalSkills = [
  {
    area: "Hardware & Embedded Systems",
    skills: [
      "Microcontrollers",
      "Microchip PIC Family",
      "Field-Programmable Gate Array (FPGA)",
      "Analog & Digital Circuit Simulation",
    ],
  },
  {
    area: "Electronics & Energy Systems",
    skills: [
      "Power Converters (Inverters, DC-DC, SMPS)",
      "Component-Level Troubleshooting",
      "PCB Rework & Repair",
      "Solar Photovoltaic (PV) Systems (Installation, Maintenance & Troubleshooting)",
    ],
  },
  {
    area: "Industrial Automation & Control",
    skills: [
      "Programmable Logic Controllers (PLCs)",
      "Human-Machine Interfaces (HMIs)",
      "Low & Medium-Voltage Variable Frequency Drives (VFDs)",
      "Industrial Communication Protocols (FOUNDATION™ Fieldbus, HART)",
      "Instrumentation & Sensors",
    ],
  },
  {
    area: "Programming Languages",
    skills: [
      "Ladder Logic (PLC)",
      "C/C++ for Embedded Systems",
      "Assembly",
      "VHDL",
    ],
  },
];
---

<BaseLayout title="About Me" style="about.css">
  <h1>Portfolio</h1>
  <section>
    <h2>Background</h2>
    <p>
      My passion for technology and engineering naturally led me to pursue a
      degree in Automation Engineering at the Technological University of Havana
      (CUJAE) from 2018 to 2023. Throughout my studies, I focused heavily on
      electric circuits, electronics, and programming. Driven by a spirit of
      collaboration, I regularly organized study groups with peers to share
      knowledge and break down complex concepts together.
    </p>
    <p>
      In 2023, I began my professional career at a personal hygiene
      manufacturing plant as an IT specialist, while also assisting with the
      maintenance and repair of automated production machinery.
    </p>
    <p>
      In 2024, I joined the <a
        href="https://x.com/EPEPCentro?s=20"
        target="_blank"
        rel="noopener noreferer"
        >Central Petroleum Drilling and Extraction Company (EPEPC)</a
      >—the country's leading crude oil production division—as an Automation
      Specialist. In this role, I expanded my hands-on expertise in industrial
      instrumentation, power electronics, and embedded control programming.
      Facing resource constraints, I successfully repaired critical electronic
      control devices to restore halted production lines. My responsibilities
      also included installing and maintaining electrical panels and
      instrumentation across extraction workflows, as well as diagnosing and
      repairing medium-voltage variable frequency drives (VFDs) at well sites.
    </p>
    <p>
      Currently, I am expanding my career focus toward embedded systems design,
      digital electronics, and software development, with a strong interest in
      integrating AI technologies directly onto embedded hardware.
    </p>
  </section>

  <section>
    <h2>Education</h2>
    {
      education.map((edu) => (
        <article class="entry-card">
          <div class="entry-header">
            <span class="entry-date">{edu.date}</span>
            <span class="entry-title">{edu.institution.name}</span>
            <span class="entry-social">
              {
                edu.institution.social_media.map(
                  (item) => (
                    <a href={item.link}><img class="icon" src={item.icon}></a>
                  )
                )
              }
            </span>
          </div>
          <p class="entry-degree">{edu.degree}</p>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Experience</h2>
    {
      experience.map((job) => (
        <article class="entry-card">
          <div class="entry-header">
            <span class="entry-date">{job.date}</span>
            <span class="entry-title">{job.company.name}</span>
            <span class="entry-social">
              {
                job.company.social_media.map(
                  (item) => (
                    <a href={item.link}><img src={item.icon} class="icon"></a>
                  )
                )
              }
            </span>
          </div>
          <ul class="entry-list">
            {job.responsibilities.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Technical Skills</h2>
    {
      technicalSkills.map((skillArea) => (
        <article class="skill-card">
          <h3 class="skill-area">{skillArea.area}</h3>
          <ul class="skill-list">
            {skillArea.skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Beyond Work</h2>
    <p><!-- hobbies, interests, whatever makes it feel like you --></p>
  </section>
</BaseLayout>


