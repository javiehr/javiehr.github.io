---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/gallery.css"

const items = [
  {
    src: "/images/gallery/graduation1.webp",
    title: "Graduation Ceremony",
    description: "With some friends at our graduation ceremony in 2023 — Havana, Cuba",
  },
  {
    src: "/images/gallery/solar.webp",
    title: "Solar Panel Installation",
    description:
      "Installing a solar panel system on a rural residential house in Cuba",
  },
  {
    src: "/images/gallery/nova_smar_1.jpeg",
    title: "PATS 2024 Event",
    description:
      "Participating in Nova Smar's PATS 2024 event with my team — Melia Havana Hotel, Cuba. <a href='https://www.smar.com.br/es/noticia/pats-2024-havana-cuba' target='_blank' rel='noopener noreferrer'>Official link</a>",
  },
  {
    src: "/images/gallery/nova_smar_2.webp",
    title: "PATS 2024 Event",
    description:
      "Encounter with some colleagues at Nova Smar's PATS 2024 event — Melia Havana Hotel, Cuba.",
  },
  {
    src: "/images/gallery/vfd_cienfuegos.webp",
    title: "Repairing a VFD",
    description:
      "Diagnosing and Repairing a VFD at the Ciego Montero Bottling Plant — Cienfuegos, Cuba",
  },
  {
    src: "/images/gallery/control_panel.webp",
    title: "Installing an Electrical Control Panel",
    description:
      "Installing the electrical panel for the control system of Crude Oil Collection Center #12 — Matanzas, Cuba",
  },
  {
    src: "/images/gallery/vd1011_failure.webp",
    title: "Troubleshooting a failure in a VFD",
    description:
      "In response to an unexpected failure of the VFD on Well VD-1011 — Matanzas, Cuba",
  },
  {
    src: "/images/gallery/vd1011_maintenance.webp",
    title: "Maintenance routine in a VFD",
    description:
      "Maintenance routine of the VFD on Well VD-1011 — Matanzas, Cuba",
  },
  {
    src: "/images/gallery/centre12.webp",
    title: "Replacement of the Pumping Unit for Well VD-101",
    description:
      "Participating in the replacement of the pump unit and VFD for well VD-1011 — Matanzas, Cuba",
  },

  // Add more entries here later — just copy this object shape
];
---

<BaseLayout title="Gallery" style="gallery.css">
  <h1>Gallery</h1>
  <p>
    Welcome to my gallery! Here you'll find some photos relevant to my career
    and work
  </p>
  <div class="gallery-grid">
    {
      items.map((item) => (
        <figure class="gallery-item">
          <img src={item.src} alt={item.title} class="gallery-thumb" />
          <figcaption>
            <h3>{item.title}</h3>
            <p set:html={item.description} />
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <img src="" alt="" />
  </div>
</BaseLayout>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = lightbox?.querySelector("img");
  const closeBtn = lightbox?.querySelector(".lightbox-close");

  function openLightbox(src: string, alt: string) {
    if (!lightbox || !lightboxImg) return;
    (lightboxImg as HTMLImageElement).src = src;
    (lightboxImg as HTMLImageElement).alt = alt;
    lightbox.classList.add("open");
    lightbox.setAttribute("aria-hidden", "false");
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove("open");
    lightbox.setAttribute("aria-hidden", "true");
  }

  document
    .querySelectorAll<HTMLImageElement>(".gallery-thumb")
    .forEach((img) => {
      img.addEventListener("click", () => openLightbox(img.src, img.alt));
    });

  closeBtn?.addEventListener("click", closeLightbox);

  // Click outside the image (on the dark backdrop) also closes it
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Escape key closes it too — good accessibility practice
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>
