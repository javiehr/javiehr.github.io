---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/index.css"

const lang = Astro.currentLocale ?? "en";
---

<BaseLayout title="Home" style="index.css">
  <Hero
    greeting="Hello, I am"
    name="Javier Horta"
    summary={[
      "I am an Automation Engineer specializing in the installation, troubleshooting, maintenance, and repair of industrial control systems and instrumentation.",
      "At heart, I see myself as a humble technician with a deep passion for electrical engineering, electronics, programming, and mechanics.",
      "I love building things hands-on—taking ideas from concept to real-world hardware that comes alive to solve practical challenges.",
    ]}
    quotes={[
      {
        text: "I have not failed. I've just found 10,000 ways that won't work.",
        author: "Thomas Edison",
        book:''
      },
      {
        text: "Imagination is more important than knowledge.",
        author: "Albert Einstein",
        book:''
      },
      {
        text: "No good can ever come from deviating from the path that you were destined to follow",
        author: "Robert Greene",
        book:', Mastery'
      },
    ]}
    ctaText="View Portfolio"
    ctaHref={getRelativeLocaleUrl(lang, "/about")}
    photoSrc="images/profile.png"
  />
</BaseLayout>
