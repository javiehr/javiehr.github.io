---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = Astro.currentLocale ?? 'en';
---
<BaseLayout title="Home">
  <Hero
    greeting="Hello, I am"
    name="Javier Horta"
    summary="I am an Automation Engineer graduated from the Technological University of Havana (CUJAE), specializing in the installation, troubleshooting, maintenance, and repair of industrial control systems and instrumentation. At heart, I am deeply passionate about electronics, electrical engineering, software development, and mechanics. I love building things hands-on—taking ideas from concept to real-world hardware that comes alive to solve practical challenges.""
    quotes={[
      { text: "I have not failed. I've just found 10,000 ways that won't work.", author: "Thomas Edison" },
      { text: "Imagination is more important than knowledge.", author: "Albert Einstein" },
      { text: "The present is theirs; the future, for which I really worked, is mine.", author: "Nikola Tesla" },
    ]}
    ctaText="View Portfolio"
    ctaHref={getRelativeLocaleUrl(lang, '/about')}
  />
</BaseLayout>